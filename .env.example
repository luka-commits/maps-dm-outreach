# Copy to .env (never commit it). Both entries are optional.
#
# Apify is only used for the Instagram/Facebook activity check and for fetching Instagram posts
# for openers. Without a token those steps are skipped. Create a token at
# https://console.apify.com/account/integrations
APIFY_TOKEN=
#
# Optional: where the SQLite database lives (default: data/leads.db)
# OUTREACH_DB=
